# Auto-assign / cloud-save / billing API base URL (CDK output "ApiUrl").
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com

# Cognito User Pool used for the paid-tier login (CDK outputs "UserPoolId" / "UserPoolClientId").
# The free tier never needs these — it has no login.
VITE_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
